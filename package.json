{
  "name": "ai-context-clipboard",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --filter @ai-clipboard/ui dev",
    "build": "pnpm --filter @ai-clipboard/ui build",
    "tauri": "pnpm exec tauri",
    "typecheck": "pnpm exec tsc --noEmit -p packages/types && pnpm exec tsc --noEmit -p packages/core && pnpm exec tsc --noEmit -p packages/ui",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@tauri-apps/cli": "^2.0.0",
    "tsx": "^4.23.1"
  }
}
